{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local/backend-product-builder/backend-change-manifest.schema.json",
  "title": "Backend Change Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "feature", "mode", "complexity", "criticality", "technology", "gate", "interfaces", "architecture", "model", "data", "security", "reliability", "observability", "testIntegrity", "repairTrace", "slice", "decision"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "1.3.0" },
    "feature": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["quick-fix", "extension", "new-build", "migration", "integration", "repair"] },
    "complexity": { "enum": ["quick", "small", "medium", "large", "complex"] },
    "criticality": { "enum": ["low", "standard", "critical"] },
    "technology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtimeContext", "selection", "language", "httpFramework", "decisionRef", "exception"],
      "properties": {
        "runtimeContext": { "enum": ["new-production-runtime", "existing-runtime", "disposable-nonproduction"] },
        "selection": { "enum": ["rust-axum-default", "preserve-existing", "task-fit-nonproduction", "approved-exception"] },
        "language": { "type": "string", "minLength": 1 },
        "httpFramework": { "type": "string", "minLength": 1 },
        "decisionRef": { "type": "string", "minLength": 1 },
        "exception": {
          "type": "object",
          "additionalProperties": false,
          "required": ["applicable", "reasonClass", "alternative", "justification", "evidenceRefs"],
          "properties": {
            "applicable": { "type": "boolean" },
            "reasonClass": { "enum": ["not-applicable", "specialized-ecosystem", "mandatory-vendor-sdk", "platform-constraint", "operational-interoperability", "measured-nfr"] },
            "alternative": { "type": "string" },
            "justification": { "type": "string" },
            "evidenceRefs": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "reasons", "conditions", "humanApprovalRequired", "status"],
      "properties": {
        "required": { "type": "boolean" },
        "reasons": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "conditions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["newServiceOrSubsystem", "publicContract", "persistenceOrMigration", "securityOrTenancy", "materialOperationalCost", "criticalRisk", "largeOrComplex"],
          "properties": {
            "newServiceOrSubsystem": { "type": "boolean" },
            "publicContract": { "type": "boolean" },
            "persistenceOrMigration": { "type": "boolean" },
            "securityOrTenancy": { "type": "boolean" },
            "materialOperationalCost": { "type": "boolean" },
            "criticalRisk": { "type": "boolean" },
            "largeOrComplex": { "type": "boolean" }
          }
        },
        "humanApprovalRequired": { "type": "boolean" },
        "status": { "enum": ["not-started", "blocked", "ready-for-backend-slice", "approved", "backend-broad-build-approved", "not-applicable"] }
      }
    },
    "interfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "contractType", "authorityMode", "exposure", "changeType", "contractPath", "scenarioMatrixPath", "validatorCommand", "validatorEvidencePath", "validatorResult", "compatibility", "deprecated"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["http", "event", "graphql", "grpc", "job", "cli"] },
          "contractType": { "enum": ["openapi", "asyncapi", "graphql-sdl", "protobuf", "arazzo", "custom"] },
          "authorityMode": { "enum": ["design-first", "code-first-exported", "external-provider"] },
          "exposure": { "enum": ["internal", "partner", "public"] },
          "changeType": { "enum": ["unchanged", "compatible", "breaking", "new"] },
          "contractPath": { "type": "string", "minLength": 1 },
          "scenarioMatrixPath": { "type": "string", "minLength": 1 },
          "validatorCommand": { "type": "string", "minLength": 1 },
          "validatorEvidencePath": { "type": "string", "minLength": 1 },
          "validatorResult": { "enum": ["passed", "failed", "partial", "not-run"] },
          "compatibility": { "type": "string", "minLength": 1 },
          "deprecated": { "type": "boolean" }
        }
      }
    },
    "architecture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["introducedMechanisms"],
      "properties": {
        "introducedMechanisms": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "justification", "driverIds", "evidencePaths"],
            "properties": {
              "kind": { "enum": ["repository", "adapter", "use-case-layer", "cache", "queue", "sharding", "microservice", "generic-abstraction", "other"] },
              "justification": { "type": "string", "minLength": 20 },
              "driverIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^(REQ|AC|D|PROP)-[A-Za-z0-9][A-Za-z0-9-]*-[0-9]{3}$" } },
              "evidencePaths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
            }
          }
        }
      }
    },
    "model": { "$ref": "#/$defs/evidenceSection" },
    "data": {
      "unevaluatedProperties": false,
      "allOf": [
        { "$ref": "#/$defs/evidenceSection" },
        {
          "type": "object",
          "required": ["materialChange", "migrationStrategy", "verificationCommand", "rollbackOrRecovery"],
          "properties": {
            "materialChange": { "type": "boolean" },
            "migrationStrategy": { "enum": ["none", "expand-contract", "backward-compatible", "maintenance-window", "forward-recovery"] },
            "verificationCommand": { "type": "string" },
            "rollbackOrRecovery": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "security": {
      "unevaluatedProperties": false,
      "allOf": [
        { "$ref": "#/$defs/evidenceSection" },
        {
          "type": "object",
          "required": ["materialChange", "asvsVersion", "authentication", "authorization", "tenancy", "sensitiveData", "boundaries"],
          "properties": {
            "materialChange": { "type": "boolean" },
            "asvsVersion": { "type": "string" },
            "authentication": { "type": "string", "minLength": 1 },
            "authorization": { "type": "string", "minLength": 1 },
            "tenancy": { "type": "string", "minLength": 1 },
            "sensitiveData": { "type": "string", "minLength": 1 },
            "boundaries": {
              "type": "array",
              "items": { "$ref": "#/$defs/securityBoundary" }
            }
          }
        }
      ]
    },
    "reliability": {
      "unevaluatedProperties": false,
      "allOf": [
        { "$ref": "#/$defs/evidenceSection" },
        {
          "type": "object",
          "required": ["slos", "timeouts", "retries", "idempotency", "concurrency", "recovery", "externalDependencies"],
          "properties": {
            "slos": { "type": "array", "items": { "type": "string" } },
            "timeouts": { "type": "string", "minLength": 1 },
            "retries": { "type": "string", "minLength": 1 },
            "idempotency": { "type": "string", "minLength": 1 },
            "concurrency": { "type": "string", "minLength": 1 },
            "recovery": { "type": "string", "minLength": 1 },
            "externalDependencies": {
              "type": "array",
              "items": { "$ref": "#/$defs/externalDependency" }
            }
          }
        }
      ]
    },
    "observability": {
      "unevaluatedProperties": false,
      "allOf": [
        { "$ref": "#/$defs/evidenceSection" },
        {
          "type": "object",
          "required": ["logs", "metrics", "traces", "audit", "sensitiveDataPolicy"],
          "properties": {
            "logs": { "type": "string", "minLength": 1 },
            "metrics": { "type": "string", "minLength": 1 },
            "traces": { "type": "string", "minLength": 1 },
            "audit": { "type": "string", "minLength": 1 },
            "sensitiveDataPolicy": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "testIntegrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["testPaths", "contractualCoverage", "assertionPolicy", "disablePolicy", "skipPolicy", "evidencePaths"],
      "properties": {
        "testPaths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "contractualCoverage": { "enum": ["preserved", "increased"] },
        "assertionPolicy": { "const": "no-net-assertion-removal" },
        "disablePolicy": { "const": "no-new-disabled-tests" },
        "skipPolicy": { "const": "no-new-skipped-tests" },
        "evidencePaths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "repairTrace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applicable", "finding", "systemicCause", "canonicalAuthorityRef", "repairEvidencePaths", "regressionTestIds", "notApplicableReason"],
      "properties": {
        "applicable": { "type": "boolean" },
        "finding": { "type": "string" },
        "systemicCause": { "type": "string" },
        "canonicalAuthorityRef": { "type": "string" },
        "repairEvidencePaths": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "regressionTestIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "notApplicableReason": { "type": "string" }
      }
    },
    "slice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "testCommands", "evidencePaths", "scorecardPath", "status"],
      "properties": {
        "scope": { "type": "string", "minLength": 1 },
        "testCommands": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "evidencePaths": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "scorecardPath": { "type": "string", "minLength": 1 },
        "status": { "enum": ["not-started", "in-progress", "blocked", "ready", "passed", "failed", "not-applicable"] }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "approver", "timestamp"],
      "properties": {
        "state": { "enum": ["approved", "approved-with-accepted-risk", "rejected", "awaiting-review", "not-required"] },
        "approver": { "type": "string" },
        "timestamp": { "type": "string" }
      }
    }
  },
  "$defs": {
    "evidenceSection": {
      "type": "object",
      "required": ["applicable", "evidencePath", "notApplicableReason"],
      "properties": {
        "applicable": { "type": "boolean" },
        "evidencePath": { "type": "string" },
        "notApplicableReason": { "type": "string" }
      }
    },
    "externalDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dependency", "timeout", "retry", "transientOnly", "idempotency", "failureMode", "evidence"],
      "properties": {
        "dependency": { "type": "string", "minLength": 1 },
        "timeout": { "type": "string", "minLength": 1 },
        "retry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maxAttempts", "backoff"],
          "properties": {
            "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 10 },
            "backoff": { "type": "string", "minLength": 1 }
          }
        },
        "transientOnly": { "type": "boolean" },
        "idempotency": { "enum": ["safe", "not-required", "unsafe"] },
        "failureMode": { "enum": ["surface-error", "fail-closed", "degrade", "queue-for-later", "retry-later"] },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "securityBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trustBoundary", "resource", "identitySource", "tenantBinding", "authorizationPoint", "negativeTestIds"],
      "properties": {
        "trustBoundary": { "type": "string", "minLength": 3 },
        "resource": { "type": "string", "minLength": 1 },
        "identitySource": { "type": "string", "minLength": 3 },
        "tenantBinding": { "type": "string", "minLength": 3 },
        "authorizationPoint": { "type": "string", "minLength": 3 },
        "negativeTestIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}

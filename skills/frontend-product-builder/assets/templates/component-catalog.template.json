  "validation": {
    "schema": "~/.agents/skills/frontend-product-builder/assets/schemas/component-catalog.schema.json",
    "checks": [
      {
        "id": "CAT-001",
        "severity": "error",
        "method": "schema",
        "blocking": true,
        "description": "The component catalog must validate against the component catalog schema.",
        "command": "node scripts/validate-component-catalog.mjs",
        "remediation": "Correct invalid or missing catalog fields."
      },
      {
        "id": "CAT-002",
        "severity": "error",
        "method": "script",
        "blocking": true,
        "description": "Component IDs, canonical names, implementations, and public imports must be unique.",
        "command": "node scripts/audit-component-catalog-collisions.mjs",
        "remediation": "Resolve duplicate canonical ownership or conflicting catalog entries."
      },
      {
        "id": "CAT-003",
        "severity": "error",
        "method": "script",
        "blocking": true,
        "description": "Component dependencies must follow the approved hierarchy and remain acyclic.",
        "command": "node scripts/audit-component-dependencies.mjs",
        "remediation": "Correct reverse dependencies, cross-layer imports, or component cycles."
      },
      {
        "id": "CAT-004",
        "severity": "error",
        "method": "script",
        "blocking": true,
        "description": "Stable components must have contracts, implementations, and required tests.",
        "command": "node scripts/audit-component-quality.mjs",
        "remediation": "Create or correct the missing contract, implementation, stories, or tests."
      },
      {
        "id": "CAT-005",
        "severity": "warning",
        "method": "script",
        "blocking": false,
        "description": "Potential component duplicates and suspicious versioned names require review.",
        "command": "node scripts/audit-component-duplicates.mjs",
        "remediation": "Reuse, merge, rename, or document why the component is semantically distinct."
      }
    ]
  },
  "deprecations": []

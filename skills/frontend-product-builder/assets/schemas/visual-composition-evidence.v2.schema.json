{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.frontend-product-builder.local/visual-composition-evidence.v2.schema.json",
  "title": "Generated Visual Composition Evidence v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifactKind", "schemaVersion", "generatedFrom", "status", "objectiveFindings", "semanticDigest"],
  "properties": {
    "artifactKind": { "const": "visual-composition-evidence" },
    "schemaVersion": { "const": "2.0.0" },
    "generatedFrom": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gateDigest"],
      "properties": { "gateDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
    },
    "status": { "enum": ["eligible", "ineligible"] },
    "objectiveFindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "message", "findingKey"],
        "properties": {
          "id": { "type": "string", "pattern": "^UI-[A-Z0-9-]+$" },
          "severity": { "enum": ["P0", "P1", "P2", "P3", "critical", "serious"] },
          "message": { "type": "string", "minLength": 1 },
          "findingKey": { "type": "string", "minLength": 1 }
        }
      }
    },
    "semanticDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec-driven.local/schemas/ui-engineering-control.schema.json",
  "title": "UI Engineering Control Plane Artifacts",
  "oneOf": [
    { "$ref": "#/$defs/platformProfile" },
    { "$ref": "#/$defs/adapterResolution" },
    { "$ref": "#/$defs/compiledPolicy" },
    { "$ref": "#/$defs/tokenResolution" },
    { "$ref": "#/$defs/expectedRenderModel" },
    { "$ref": "#/$defs/sourceFacts" },
    { "$ref": "#/$defs/renderEvidence" },
    { "$ref": "#/$defs/findings" },
    { "$ref": "#/$defs/qualityGate" },
    { "$ref": "#/$defs/capabilityReceipt" },
    { "$ref": "#/$defs/humanDecision" },
    { "$ref": "#/$defs/attestation" },
    { "$ref": "#/$defs/compositionV2" },
    { "$ref": "#/$defs/scorecardV2" }
  ],
  "$defs": {
    "sha256": { "type": ["string", "null"], "pattern": "^(?:[a-f0-9]{64})?$" },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project", "commit"],
      "properties": {
        "project": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "minLength": 1 }
      }
    },
    "base": {
      "type": "object",
      "required": ["artifactKind", "schemaVersion", "semanticDigest"],
      "properties": {
        "artifactKind": { "type": "string", "minLength": 1 },
        "schemaVersion": { "type": "string", "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$" },
        "semanticDigest": { "$ref": "#/$defs/sha256" },
        "subject": { "$ref": "#/$defs/subject" }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "severity", "source", "message", "findingKey"],
      "properties": {
        "id": { "type": "string", "pattern": "^UI-[A-Z0-9-]+$" },
        "severity": { "enum": ["P0", "P1", "P2", "P3", "critical", "serious"] },
        "source": { "const": "objective" },
        "message": { "type": "string", "minLength": 1 },
        "findingKey": { "type": "string", "minLength": 1 }
      }
    },
    "platformProfile": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "properties": {
            "artifactKind": { "const": "ui-platform-profile" },
            "uiSurfaces": { "type": "array", "minItems": 1, "items": { "type": "object" } }
          },
          "required": ["subject", "uiSurfaces"]
        }
      ]
    },
    "adapterResolution": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "properties": {
            "artifactKind": { "const": "ui-adapter-resolution" },
            "status": { "enum": ["resolved", "unsupported"] },
            "adapterId": { "type": ["string", "null"] },
            "profileDigest": { "$ref": "#/$defs/sha256" },
            "sourceParser": { "type": ["object", "null"] },
            "runtimeCollector": { "type": ["object", "null"] }
          },
          "required": ["subject", "status", "adapterId", "profileDigest", "sourceParser", "runtimeCollector"]
        }
      ]
    },
    "compiledPolicy": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "properties": {
            "artifactKind": { "const": "ui-policy-compiled" },
            "adapterId": { "type": "string", "minLength": 1 },
            "recipes": { "type": "array", "minItems": 1 },
            "components": { "type": "array", "minItems": 1 },
            "statuses": { "type": "object", "minProperties": 1 },
            "locale": { "type": "object" }
          },
          "required": ["subject", "adapterId", "recipes", "components", "statuses", "locale"]
        }
      ]
    },
    "tokenResolution": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "properties": {
            "artifactKind": { "const": "ui-token-resolution" },
            "tokens": { "type": "object", "minProperties": 1 }
          },
          "required": ["subject", "tokens"]
        }
      ]
    },
    "expectedRenderModel": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "properties": {
            "artifactKind": { "const": "expected-render-model" },
            "elements": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["id", "role"] } },
            "relations": { "type": "object" }
          },
          "required": ["subject", "policyDigest", "elements", "relations"]
        }
      ]
    },
    "sourceFacts": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "properties": {
            "artifactKind": { "const": "source-ui-facts" },
            "provenance": { "type": "object", "required": ["adapterId", "parser"] },
            "files": { "type": "array", "minItems": 1 },
            "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } }
          },
          "required": ["subject", "policyDigest", "provenance", "files", "findings"]
        }
      ]
    },
    "renderEvidence": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "properties": {
            "artifactKind": { "const": "rendered-ui-evidence" },
            "provenance": { "type": "object", "required": ["adapterId", "locale", "timezoneId", "fixtureDigest"] },
            "elements": { "type": "array", "minItems": 1 },
            "relations": { "type": "object" },
            "accessibility": { "type": "array" }
          },
          "required": ["subject", "provenance", "elements", "relations", "accessibility"]
        }
      ]
    },
    "findings": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "properties": {
            "artifactKind": { "const": "ui-findings" },
            "policyDigest": { "$ref": "#/$defs/sha256" },
            "coverage": { "type": "object", "required": ["expected", "observed", "missing"] },
            "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } }
          },
          "required": ["subject", "policyDigest", "coverage", "findings"]
        }
      ]
    },
    "qualityGate": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "properties": {
            "artifactKind": { "const": "ui-quality-gate" },
            "eligible": { "type": "boolean" },
            "blockingFindingIds": { "type": "array", "uniqueItems": true },
            "receiptDigests": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sha256" } },
            "productDesignVerification": { "type": "object", "required": ["required", "supplied", "valid", "passed", "stale", "status", "digest", "errors"] }
          },
          "required": ["subject", "eligible", "blockingFindingIds", "objectiveFindingDigest", "receiptDigests", "productDesignVerification"]
        }
      ]
    },
    "fileRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "sha256"],
      "properties": { "ref": { "type": "string", "minLength": 1, "pattern": "^(?!\\.\\.(?:/|$))(?!/).+" }, "sha256": { "$ref": "#/$defs/sha256" } }
    },
    "capabilityReceipt": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "properties": {
            "artifactKind": { "const": "capability-receipt" },
            "capabilityId": { "enum": ["frontend-ui-policy-control", "frontend-ui-source-control", "frontend-ui-render-control", "frontend-ui-evidence-integrity"] },
            "command": { "type": "array", "minItems": 1 },
            "evidenceRoot": {
              "type": "object",
              "additionalProperties": false,
              "required": ["scheme", "absolutePath"],
              "properties": {
                "scheme": { "const": "receipt-relative-v1" },
                "absolutePath": { "type": "string", "pattern": "^/" }
              }
            },
            "inputs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/fileRecord" } },
            "outputs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/fileRecord" } },
            "exitCode": { "type": "integer", "minimum": 0 }
          },
          "required": ["subject", "capabilityId", "command", "evidenceRoot", "inputs", "outputs", "exitCode"]
        }
      ]
    },
    "humanDecision": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "properties": {
            "artifactKind": { "const": "human-decision-receipt" },
            "principal": { "type": "string", "minLength": 1 },
            "decision": { "enum": ["approved", "approved-with-changes", "approved-with-accepted-risk", "rejected"] },
            "authorityScope": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "evidenceRefs"],
              "properties": {
                "kind": { "enum": ["product-truth", "brand-or-asset-rights", "critical-consequence", "accepted-risk", "broad-build-authorization", "release-authorization"] },
                "evidenceRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
              }
            },
            "risk": {
              "type": ["object", "null"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "owner": { "type": "string", "minLength": 1 },
                "scope": { "type": "string", "minLength": 1 },
                "expiry": { "type": "string", "minLength": 1 },
                "mitigation": { "type": "string", "minLength": 1 }
              }
            },
            "signatureNamespace": { "const": "sde-human-decision-v1" }
          },
          "required": ["subject", "principal", "decision", "gateDigest", "authorityScope", "risk", "signatureNamespace"],
          "allOf": [{
            "if": { "properties": { "decision": { "const": "approved-with-accepted-risk" } }, "required": ["decision"] },
            "then": { "properties": { "risk": { "type": "object", "required": ["id", "owner", "scope", "expiry", "mitigation"] } } }
          }]
        }
      ]
    },
    "attestation": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "additionalProperties": false,
          "properties": {
            "artifactKind": { "const": "ui-conformance-attestation" },
            "schemaVersion": { "const": "1.0.0" },
            "semanticDigest": { "$ref": "#/$defs/sha256" },
            "subject": { "$ref": "#/$defs/subject" },
            "policyDigest": { "$ref": "#/$defs/sha256" },
            "gateDigest": { "$ref": "#/$defs/sha256" },
            "receiptDigests": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sha256" } },
            "decision": { "enum": ["approved", "approved-with-changes", "approved-with-accepted-risk", "rejected"] },
            "decisionDigest": { "$ref": "#/$defs/sha256" }
          },
          "required": ["artifactKind", "schemaVersion", "semanticDigest", "subject", "policyDigest", "gateDigest", "receiptDigests", "decision", "decisionDigest"]
        }
      ]
    },
    "compositionV2": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "properties": {
            "artifactKind": { "const": "visual-composition-evidence" },
            "schemaVersion": { "const": "2.0.0" },
            "generatedFrom": { "type": "object", "required": ["gateDigest"] },
            "objectiveFindings": { "type": "array" }
          },
          "required": ["generatedFrom", "status", "objectiveFindings"]
        }
      ]
    },
    "scorecardV2": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "properties": {
            "artifactKind": { "const": "visual-quality-scorecard" },
            "schemaVersion": { "const": "2.0.0" },
            "generatedFrom": { "type": "object", "required": ["gateDigest"] },
            "objectiveCriteria": { "type": "array" }
          },
          "required": ["generatedFrom", "decisionState", "objectiveCriteria"]
        }
      ]
    }
  }
}

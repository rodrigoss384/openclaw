{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local/spec-driven-engineering/frontend-representative-loop.schema.json",
  "title": "Frontend Representative Closed Repair Loop Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "generated", "generatedAt", "screenId", "stateId", "evidenceSha256", "craftContractSha256", "contractSetSha256", "previous", "counters", "objectiveAudit", "critique", "normalizedFindings", "routes", "phase", "humanGate", "nextActions"],
  "properties": {
    "$schema": { "const": "frontend-representative-loop.schema.json" },
    "schemaVersion": { "const": "1.0.0" },
    "generated": { "const": true },
    "generatedAt": { "type": "string", "minLength": 1 },
    "screenId": { "type": "string", "minLength": 1 },
    "stateId": { "type": "string", "minLength": 1 },
    "evidenceSha256": { "$ref": "#/$defs/sha256" },
    "craftContractSha256": { "$ref": "#/$defs/sha256" },
    "contractSetSha256": { "$ref": "#/$defs/sha256" },
    "previous": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["phase", "evidenceSha256", "craftRoundsUsed", "polishRoundsUsed"],
      "properties": {
        "phase": { "$ref": "#/$defs/phase" },
        "evidenceSha256": { "$ref": "#/$defs/sha256" },
        "craftRoundsUsed": { "type": "integer", "minimum": 0 },
        "polishRoundsUsed": { "type": "integer", "minimum": 0 }
      }
    },
    "counters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["craftRoundsUsed", "maxCraftRounds", "polishRoundsUsed", "maxPolishRounds"],
      "properties": {
        "craftRoundsUsed": { "type": "integer", "minimum": 0, "maximum": 2 },
        "maxCraftRounds": { "const": 2 },
        "polishRoundsUsed": { "type": "integer", "minimum": 0, "maximum": 1 },
        "maxPolishRounds": { "const": 1 }
      }
    },
    "objectiveAudit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "command"],
      "properties": {
        "status": { "const": "passed" },
        "command": { "type": "string", "minLength": 1 }
      }
    },
    "critique": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "sourceArtifact", "totalFindings", "materialFindings"],
      "properties": {
        "status": { "enum": ["missing", "normalized"] },
        "sourceArtifact": { "type": ["string", "null"] },
        "totalFindings": { "type": "integer", "minimum": 0 },
        "materialFindings": { "type": "integer", "minimum": 0 }
      }
    },
    "normalizedFindings": { "$ref": "#/$defs/normalizedFindings" },
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["findingId", "class", "defectKind", "owner", "affectedContracts", "repairStrategy", "providerCommand", "returnStage", "revalidationSet"],
        "properties": {
          "findingId": { "type": "string", "minLength": 1 },
          "class": { "type": "string", "minLength": 1 },
          "defectKind": { "enum": ["implementation", "contract"] },
          "owner": { "type": "string", "minLength": 1 },
          "affectedContracts": { "$ref": "#/$defs/stringList" },
          "repairStrategy": { "type": "string", "minLength": 1 },
          "providerCommand": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["name", "governance", "requiresExplicitApproval"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "governance": { "type": "string", "minLength": 1 },
              "requiresExplicitApproval": { "type": "boolean" }
            }
          },
          "returnStage": { "enum": ["PATCH", "DESIGN_READINESS"] },
          "revalidationSet": { "$ref": "#/$defs/stringList" }
        }
      }
    },
    "phase": { "$ref": "#/$defs/phase" },
    "humanGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eligible", "reason"],
      "properties": {
        "eligible": { "type": "boolean" },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "nextActions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "stage", "command", "findingIds", "requiresHumanApproval"],
        "properties": {
          "type": { "enum": ["run-critique", "return-design-readiness", "targeted-implementation-repair", "provider-repair", "rerender", "reaudit", "recritique", "provider-polish", "request-human-gate", "stop-escalate"] },
          "stage": { "type": "string", "minLength": 1 },
          "command": { "type": ["string", "null"] },
          "findingIds": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "requiresHumanApproval": { "type": "boolean" },
          "affectedContracts": { "$ref": "#/$defs/stringList" },
          "revalidationSet": { "$ref": "#/$defs/stringList" }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "phase": { "enum": ["critique-required", "repair-required", "polish-required", "design-readiness-return", "human-gate-ready", "exhausted"] },
    "stringList": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "normalizedFindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "class", "defectKind", "summary", "source", "severity", "material", "target", "sourceArtifact", "evidenceRefs", "fingerprint"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "class": { "type": "string", "minLength": 1 },
          "defectKind": { "enum": ["implementation", "contract"] },
          "summary": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 },
          "severity": { "enum": ["p0", "p1", "p2", "p3", "info"] },
          "material": { "type": "boolean" },
          "target": { "type": ["string", "null"] },
          "sourceArtifact": { "type": ["string", "null"] },
          "evidenceRefs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "fingerprint": { "$ref": "#/$defs/sha256" }
        }
      }
    }
  }
}

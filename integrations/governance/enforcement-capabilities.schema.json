{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local/spec-driven-engineering/enforcement-capabilities.schema.json",
  "title": "Governance Enforcement Capability Registry",
  "description": "Typed registry of production enforcement capabilities referenced by governance rules. Stable capability IDs hide repository path topology from the rule registry.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "status",
    "capabilities"
  ],
  "properties": {
    "$schema": {
      "const": "./enforcement-capabilities.schema.json"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "status": {
      "const": "foundation"
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/capability"
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "capabilityId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "authorityId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "stage": {
      "enum": [
        "every-stage",
        "discovery",
        "specification",
        "acceptance",
        "design-readiness",
        "implementation",
        "backend-representative",
        "frontend-representative",
        "adversarial",
        "evidence-release",
        "session-closure"
      ]
    },
    "inputContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "required",
        "description"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/capabilityId"
        },
        "type": {
          "enum": [
            "repository-root",
            "directory",
            "json-file",
            "markdown-file",
            "file",
            "artifact"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "description": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "cli",
            "schema"
          ]
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "argv": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "choices": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "failureSemantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "blocking"
      ],
      "properties": {
        "mode": {
          "enum": [
            "nonzero-exit",
            "schema-rejection"
          ]
        },
        "blocking": {
          "type": "boolean"
        }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "owner",
        "kind",
        "description",
        "entrypoint",
        "invocation",
        "inputContracts",
        "failureSemantics",
        "supportedStages"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/capabilityId"
        },
        "owner": {
          "$ref": "#/$defs/authorityId"
        },
        "kind": {
          "enum": [
            "schema",
            "validator",
            "controller",
            "ci-gate"
          ]
        },
        "description": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "entrypoint": {
          "type": "string",
          "minLength": 1
        },
        "invocation": {
          "$ref": "#/$defs/invocation"
        },
        "inputContracts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/inputContract"
          }
        },
        "failureSemantics": {
          "$ref": "#/$defs/failureSemantics"
        },
        "supportedStages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stage"
          }
        }
      }
    }
  }
}

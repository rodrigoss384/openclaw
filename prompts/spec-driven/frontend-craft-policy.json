  },
  "representativeReview": {
    "command": "critique",
    "mode": "primary",
    "requiredFor": "substantial-frontend",
    "requiresBrowserEvidence": true,
    "requiresCompositionEvidence": true,
    "mayApproveGate": false
  },
  "finalAudit": {
    "command": "audit",
    "requiredFor": "critical-ui",
    "optionalFor": "standard-substantial-ui",
    "mayReplaceExistingObjectiveValidators": false
  },
  "polish": {
    "maxVisualInspectionRounds": 2,
    "maxPolishRounds": 1
  },
  "commands": {
    "managed": [
      "shape",
      "critique",
      "layout",
      "typeset",
      "adapt",
      "clarify",
      "polish"
    ],
    "findingDriven": [
      "harden",
      "optimize",
      "distill",
      "colorize"
    ],
    "explicitApproval": [
      "bolder",
      "quieter",
      "animate",
      "delight",
      "live"
    ],
    "strongExplicitApproval": [
      "overdrive"
    ],
    "notCanonicalInManagedWorkflow": [
      "init",
      "document"
    ],
    "designSystemMaintenanceOnly": [
      "extract"
    ]
  },
  "visitorModes": {
    "application-shell": "operate",
    "dashboard": "operate",
    "searchable-list": "operate",
    "entity-detail": "operate",
    "form-workflow": "operate",
    "administration": "operate",
    "authentication": "operate",
    "review-approval": "operate",
    "landing": "persuade",
    "marketing": "persuade",
    "documentation": "read",
    "guide": "read",
    "portfolio": "experience",
    "gallery": "experience"
  },
  "guardrails": {
    "impeccableMay": [
      "critique",
      "propose",
      "detect",
      "refine"
    ],
    "impeccableMayNotSilentlyRedefine": [
      "approved-product-behavior",
      "visual-authority",
      "design-system-ownership",
      "behavioral-ux-policy",
      "screen-contracts",
      "release-gates",
      "authentication-contracts",
      "data-and-api-contracts"
    ],
    "behavioralUxPrecedes": [
      "onboarding-persuasion",
      "pricing-persuasion",
      "upgrade-persuasion",
      "retention-persuasion"
    ],
    "hardenIsAdvisoryTo": [
      "data-and-forms-contract",
      "screen-state-matrix",
      "api-integration-contract",
      "authentication-contract"
    ],
    "projectWideDetectorIgnoreRequiresHumanApproval": true,
    "narrowIgnoreRequiresDecisionOrDesignSystemRuleId": true
  },
  "rollout": {
    "phase": "primary",
    "frontendDesign": "legacy-fallback-explicit-only",
    "impeccable": "primary-visual-craft-authority",
    "cutoverRequires": [
      "representative-slices-reviewed",
      "false-positive-review",
      "no-authority-conflicts",
      "adapter-and-lock-validation"
    ]
  },
  "repairLoop": {
    "controller": "integrations/impeccable/frontend-control.mjs",
    "reportSchema": "integrations/impeccable/frontend-representative-loop.schema.json",
    "normalizedFindingBatchSchema": "integrations/impeccable/normalized-finding-batch.schema.json",
    "classification": "explicit-taxonomy-no-free-text-inference",
    "sequence": [
      "evidence",
      "objective-audit",
      "critique",
      "normalize",
      "route",
      "repair",
      "rerender",
      "reaudit",
      "recritique"
    ],
    "maxCraftRounds": 2,
    "maxPolishRounds": 1,
    "noMaterialFindingTransition": "human-gate",
    "contractFindingTransition": "design-readiness",
    "implementationFindingTransition": "patch",
    "rerenderAfterRepair": true,
    "reauditAfterRepair": true,
    "recritiqueAfterRepair": true,
    "polishMode": "explicit-request-only"
  }
}

{
  "$schema": "../../integrations/impeccable/frontend-craft-policy.schema.json",
  "provider": {
    "id": "impeccable",
    "package": "impeccable",
    "version": "3.5.0",
    "authority": "bounded-advisory",
    "canonicalContext": "spec-driven",
    "contextMode": "derived-projection"
  },
  "authority": {
    "productBehavior": "spec-driven-engineering",
    "frontendArchitecture": "frontend-product-builder",
    "visualCraft": "impeccable",
    "browserEvidence": "playwright-skill",
    "behavioralInfluence": "behavioral-ux-contract",
    "implementationIdioms": [
      "react-best-practices",
      "react-composition-patterns",
      "tailwind-patterns"
    ],
    "rule": "one-concern-one-authority-other-skills-may-advise-never-compete",
    "precedence": [
      "product-requirements-and-acceptance-contracts",
      "security-behavioral-ux-and-interface-contracts",
      "frontend-product-context",
      "approved-design-direction",
      "design-system",
      "styling-authority",
      "screen-specification",
      "composition-proof",
      "impeccable-selected-craft-direction",
      "impeccable-detector-and-critique-findings",
      "implementation"
    ]
  },
  "contextBridge": {
    "direction": "canonical-to-provider-only",
    "environmentVariable": "IMPECCABLE_CONTEXT_DIR",
    "baseDirectory": "${TMPDIR:-/tmp}/spec-driven-impeccable",
    "productProjection": "PRODUCT.md",
    "designProjection": "DESIGN.md",
    "provenanceArtifact": "frontend-craft-provenance.json",
    "includeSourceSha256": true,
    "providerArtifactsAreCanonical": false
  },
  "craftContract": {
    "mode": "derived",
    "schema": "integrations/impeccable/craft-contract.schema.json",
    "artifact": "craft-contract.json",
    "canonical": false,
    "persistence": "temporary-until-evidence",
    "visualFamilyDerivation": "visitor-mode-plus-recipe",
    "unresolvedPolicy": "explicit-never-infer-from-prompt",
    "contractSetIdentity": "sha256-of-ordered-source-identities",
    "componentCatalogDependencyMode": "screen-component-map",
    "perceptualPolicyPointer": "design-system.json#visualGrammar.perceptualPolicy"
  },
  "detector": {
    "required": true,
    "hook": "preferred-when-supported",
    "fallback": "manual-detector",
    "hookAbsenceBlocks": false
  },
  "visualDirection": {
    "command": "shape",
    "mode": "primary",
    "requiredWhen": "readiness-controller-provider-open",
    "writesProductionCode": false,
    "selectedOutputRole": "approved-visual-reference-not-implementation-contract"
  },
  "readiness": {
    "controller": "integrations/impeccable/frontend-control.mjs",
    "reportSchema": "integrations/impeccable/frontend-readiness.schema.json",
    "relationshipMode": "resolved-unresolved-blocked",
    "shapeInvocation": "unresolved-provider-eligible-only",
    "canonicalAdoptionRequired": true,
    "rederiveAfterAdoption": true,
    "unchangedAfterAdoption": "block-contract-model-do-not-repeat-shape",
    "dimensionRoutes": {
      "spatialComposition": {
        "owner": "frontend-product-builder",
        "providerEligible": false,
        "canonicalTargets": [
          "recipe",
          "screen-specification"
        ],
        "requiredSourceRoles": [
          "screen-spec",
          "recipe"
        ]
      },
      "perceptualHierarchy": {
        "owner": "impeccable",
        "providerEligible": true,
        "canonicalTargets": [
          "design-direction",
          "design-system",
          "screen-specification"
        ],
        "requiredSourceRoles": [
          "screen-spec",
          "recipe",
          "visual-direction",
          "design-system"
        ]
      },
      "semanticPresentation": {
        "owner": "frontend-product-builder",
        "providerEligible": false,
        "canonicalTargets": [
          "design-system",
          "component-catalog",
          "screen-specification"
        ],
        "requiredSourceRoles": [
          "screen-spec",
          "design-system",
          "component-catalog"
        ]
      },
      "interactionClarity": {
        "owner": "frontend-product-builder",
        "providerEligible": false,
        "canonicalTargets": [
          "product-context",
          "recipe",
          "screen-specification"
        ],
        "requiredSourceRoles": [
          "screen-spec",
          "recipe"
        ]
      },
      "decisionSupport": {
        "owner": "spec-driven-engineering",
        "providerEligible": false,
        "canonicalTargets": [
          "product-context",
          "screen-specification"
        ],
        "requiredSourceRoles": [
          "screen-spec"
        ]
      },
      "typographyCoherence": {
        "owner": "impeccable",
        "providerEligible": true,
        "canonicalTargets": [
          "design-direction",
          "design-system",
          "screen-specification"
        ],
        "requiredSourceRoles": [
          "screen-spec",
          "visual-direction",
          "design-system"
        ]
      }
    }
  },
  "findingRouter": {
    "schema": "integrations/impeccable/finding-route.schema.json",
    "classification": "explicit-taxonomy-no-free-text-inference",
    "returnStageByDefectKind": {
      "implementation": "PATCH",
      "contract": "DESIGN_READINESS"
    },
    "repairStrategyByDefectKind": {
      "implementation": "targeted-implementation-repair",
      "contract": "canonical-contract-repair"
    },
    "classes": {
      "spatial-density": {
        "implementationOwner": "frontend-product-builder",
        "contractOwner": "frontend-product-builder",
        "affectedContracts": [
          "recipe",
          "screen-specification",
          "composition-proof"
        ],
        "providerCommand": "layout",
        "revalidationSet": [
          "craft-contract",
          "composition-proof",
          "browser-evidence",
          "impeccable-detector"
        ]
      },
      "surface-layering": {
        "implementationOwner": "frontend-product-builder",
        "contractOwner": "frontend-product-builder",
        "affectedContracts": [
          "design-system",
          "recipe",
          "screen-specification",
          "composition-proof"
        ],
        "providerCommand": "layout",
        "revalidationSet": [
          "craft-contract",
          "design-system",
          "composition-proof",
          "browser-evidence",
          "impeccable-detector"
        ]
      },
      "surface-economy": {
        "implementationOwner": "frontend-product-builder",
        "contractOwner": "frontend-product-builder",
        "affectedContracts": [
          "design-system",
          "recipe",
          "screen-specification",
          "composition-proof"
        ],
        "providerCommand": "distill",
        "revalidationSet": [
          "craft-contract",
          "design-system",
          "composition-proof",
          "browser-evidence",
          "impeccable-detector"
        ]
      },
      "accent-overuse": {
        "implementationOwner": "frontend-product-builder",
        "contractOwner": "frontend-product-builder",
        "affectedContracts": [
          "design-system",
          "screen-specification"
        ],
        "providerCommand": "quieter",
        "revalidationSet": [
          "craft-contract",
          "design-system",
          "browser-evidence",
          "impeccable-detector"
        ]
      },
      "semantic-color": {
        "implementationOwner": "frontend-product-builder",
        "contractOwner": "frontend-product-builder",
        "affectedContracts": [
          "design-system",
          "screen-specification"
        ],
        "providerCommand": "colorize",
        "revalidationSet": [
          "craft-contract",
          "design-system",
          "browser-evidence",
          "impeccable-detector"
        ]
      },
      "semantic-presentation": {
        "implementationOwner": "frontend-product-builder",
        "contractOwner": "frontend-product-builder",
        "affectedContracts": [
          "design-system",
          "screen-specification",
          "component-catalog"
        ],
        "providerCommand": null,
        "revalidationSet": [
          "craft-contract",
          "screen-specification",
          "component-catalog",
          "design-system",
          "browser-evidence"
        ]
      },
      "text-hierarchy": {
        "implementationOwner": "frontend-product-builder",
        "contractOwner": "frontend-product-builder",
        "affectedContracts": [
          "design-system",
          "screen-specification"
        ],
        "providerCommand": "typeset",
        "revalidationSet": [
          "craft-contract",
          "screen-specification",
